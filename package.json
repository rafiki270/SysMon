{
  "name": "sysmon",
  "version": "1.0.0",
  "private": true,
  "description": "Four-machine fullscreen operations and subscription monitor",
  "author": "Ondrej Rafaj",
  "main": "app/main.cjs",
  "scripts": {
    "start": "electron .",
    "build:icons": "node scripts/build-icons.cjs",
    "test": "node --test tests/*.test.cjs",
    "test:flows": "playwright test",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "@fortawesome/free-brands-svg-icons": "7.3.1",
    "@fortawesome/free-solid-svg-icons": "7.3.1",
    "@playwright/test": "1.63.0",
    "electron": "44.5.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.rafiki.sysmon",
    "productName": "SysMon",
    "files": [
      "app/**/*",
      "daemon/*.cjs",
      "package.json"
    ],
    "win": {
      "target": "portable"
    },
    "mac": {
      "target": [
        "dmg",
        "dir"
      ],
      "category": "public.app-category.utilities"
    },
    "linux": {
      "target": [
        "AppImage",
        "dir"
      ],
      "category": "Utility"
    }
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "bonjour-service": "^1.4.4",
    "zod": "^3.25.76"
  }
}
